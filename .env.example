# Copy this file to ".env" (same folder) and paste YOUR OWN key after the = sign.
# .env is ignored by git, so the key stays on your computer. Never commit a real key.
# Free key: https://aistudio.google.com/apikey  (sign in with a Google account, "Create API key")
GOOGLE_API_KEY=

# Optional: force the AI that drafts rules ("gemini" or "ollama"). Default: gemini when a key is set.
# PURPLE_AI_PROVIDER=gemini
# PURPLE_GEMINI_MODEL=gemini-3.8-flash
# PURPLE_GEMINI_FALLBACK=gemini-3.7-flash,gemini-3.5-flash   (tried in order if the main model is overloaded)

# Optional: Claude for the trading bot (paid per use; API credit from https://platform.claude.com).
# Check it first:  backend\.venv\Scripts\python.exe tools\claude_check.py
ANTHROPIC_API_KEY=
